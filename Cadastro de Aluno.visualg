algoritmo " Cadastro de Alunos"

 var

  nomeAluno: caracter
  qtAlunos, contador: inteiro
  nomesAlunos: vetor [1..1024] de caractere

 inicio

  contador <- 1
  escreval("Insira a quantidade de alunos: ")
  leia(qtAlunos)

   para contador de 1 ate qtAlunos faca
    escreval("Insira o nome do ", contador, "º aluno: ")
    leia(nomeAluno)
    nomesAlunos[contador] <- nomeAluno

 fimpara 
 
 contador <- 1

  para contador de 1 ate qtAlunos faca
   escreval(nomesAlunos[contador])

  fimpara

fimalgoritmo
     